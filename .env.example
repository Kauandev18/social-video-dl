# Links para baixar (separe por vírgula, espaço ou quebra de linha)
VIDEO_URLS=https://www.tiktok.com/@usuario/video/123456,https://www.instagram.com/reel/ABC123

# Pasta de destino (padrão: ./downloads)
OUTPUT_DIR=./downloads

# (Opcional) Caminho para cookies.txt no formato Netscape — necessário para stories/conteúdo privado
COOKIES_FILE=

# (Opcional) Navegador de onde o yt-dlp lê a sessão: firefox, chrome, edge, brave
# Usado somente se COOKIES_FILE estiver vazio
COOKIES_BROWSER=
