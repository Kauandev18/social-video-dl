# URLs dos vídeos a baixar (separados por vírgula, espaço ou quebra de linha)
VIDEO_URLS=https://www.tiktok.com/@usuario/video/123456789,https://www.instagram.com/reel/XXXXXXX

# Pasta de destino dos downloads (padrão: ./downloads)
OUTPUT_DIR=./downloads

# (Opcional) Caminho para um arquivo cookies.txt no formato Netscape
# Necessário para stories ou conteúdo que exige login
COOKIES_FILE=

# (Opcional) Navegador de onde o yt-dlp lê a sessão ativa
# Usado somente se COOKIES_FILE estiver vazio
# Valores aceitos: firefox, chrome, edge, brave
COOKIES_BROWSER=
